{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinetiq",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS"
  },
  "env": {
    "dev": {
      "name": "kinetiq-dev",
      "observability": {
        "enabled": true
      },
      "assets": {
        "directory": "frontend",
        "binding": "ASSETS"
      }
    }
  }
}
