{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinetiq",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS"
  }
}
